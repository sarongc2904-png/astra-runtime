# ASTRA runtime configuration — copy to a local env / .env and fill in. PLACEHOLDERS ONLY (no real secrets).

# Provider selection: openrouter | lmstudio
ASTRA_LLM_PROVIDER=
# Model id (provider-specific). OpenRouter e.g. openai/gpt-5-mini ; LM Studio = your loaded model id.
ASTRA_LLM_MODEL=

# --- OpenRouter (cloud) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- LM Studio (local) ---
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=
LMSTUDIO_API_KEY=lm-studio

# --- Runtime tuning ---
ASTRA_TIMEOUT_MS=120000
ASTRA_RETRY_BUDGET=1
ASTRA_OUTPUT_TOKEN_BUDGET=16000

# --- Agent V1 retrieval runtime (required by Strategy-F; do not change Agent V1 itself) ---
# STRATEGY_F_PYTHON=C:\Users\<you>\.cache\codex-runtimes\codex-primary-runtime\dependencies\python\python.exe
# PYTHONIOENCODING=utf-8
# PYTHONUTF8=1
