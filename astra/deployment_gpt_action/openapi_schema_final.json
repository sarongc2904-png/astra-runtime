    "/functions/v1/astra-tools/creative-generation": {
      "post": {
        "operationId": "runAstraCreativeGeneration",
        "summary": "Generate or revise an approved creative direction with visual QA.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
